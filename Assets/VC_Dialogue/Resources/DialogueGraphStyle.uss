/* =========================================
   DialogueGraphStyle.uss  (no structural pseudos)
   ========================================= */

/* Canvas background */
GraphView { background-color: #1f1f1f; }
.graph-view { background-color: #1f1f1f; }

/* Node shell */
/* Cleaned DialogueGraphStyle.uss - targeted for Unity 2022.3 LTS */

/* Canvas background */
GraphView { background-color: #1f1f1f; }

/* Node shell */
.dialogue-node {
    background-color: #2f3136;
    border-color: #6b7280;
    border-width: 2px;
    border-radius: 10px;
    padding: 6px;
}

/* Title area (we place the main output port here) */
.dialogue-node__title {
    background-color: #3a3d44;
    -unity-font-style: bold;
    color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4px 12px 4px 8px; /* top/right/bottom/left */
}

/* If the connector element exists in the title, style it */
.dialogue-node__title .connector,
.dialogue-node__title .cap {
    width: 14px; height: 14px; min-width: 14px; min-height: 14px;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
    border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
    border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;
    border-top-color: #0d1117; border-right-color: #0d1117; border-bottom-color: #0d1117; border-left-color: #0d1117;
    background-color: #60a5fa;
}

/* Decorative fallback anchor if connector DOM isn't available */
.dg-output-anchor { width:14px; height:14px; border-radius:7px; border-width:2px; border-color:#0d1117; background-color:#60a5fa; }

/* Generic labels / text fields / buttons */
Label { color: #dcdcdc; font-size: 12px; }
.unity-text-field { background-color: #3a3a3a; color: #ffffff; border-color: #555555; border-radius: 3px; padding-left: 4px; padding-right: 4px; }
.unity-button { background-color: #4b8df8; color: #ffffff; border-radius: 4px; padding: 2px 6px; }

/* MiniMap tint */
MiniMap, .minimap { background-color: rgba(0,0,0,0.45); }

/* Small interior spacing */
.dialogue-node .main { padding-top: 6px; }

/* Choice list area */
.dialogue-node .unity-list-view__content { display:flex; flex-direction:column; }

/* Choice row layout */
.dg-choice-row { display:flex; flex-direction:row; align-items:center; justify-content:space-between; height:24px; }
.dg-choice-text { flex-grow:1; flex-shrink:1; min-width:0; }
.dg-choice-cond { width:120px; }
.dg-choice-del { background-color:#d9534f; color:#ffffff; border-radius:3px; padding:2px 6px; }

/* Choice port container and connector */
.dg-choice-portc { width:24px; display:flex; align-items:center; justify-content:flex-end; }
.dg-choice-portc .connector, .dg-choice-portc .cap { width:14px; height:14px; border-radius:7px; border-width:2px; border-color:#0d1117; background-color:#60a5fa; }
.dg-choice-portc:hover .connector, .dg-choice-portc:hover .cap { background-color:#93c5fd; }

/* Ensure default right-side output column is visible (no override) */


/* start node visual style */
.start-node {
    border-left-width: 6px;
    border-left-color: #2ecc71;
}

/* small pill in the node title bar */
.start-badge {
    margin-left: 6px;
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: white;
    background-color: #2ecc71;
}

/* end node visual style */
.end-node {
    border-left-width: 6px;
    border-left-color: #e74c3c;
}

/* small pill in the node title bar */
.end-badge {
    margin-left: 6px;
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: white;
    background-color: #e74c3c;
}